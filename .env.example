# Supabase project settings (Project Settings -> API). Copy to .env.local and fill in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Per-coach settings - the only things a different coach needs to change to
# reuse this codebase on their own deployment. Optional for local dev; see
# the fallback values in src/config.ts.
VITE_WHATSAPP_PHONE=
VITE_COMMUNITY_URL=
VITE_COACH_NAME=
VITE_COACH_EMAIL=
